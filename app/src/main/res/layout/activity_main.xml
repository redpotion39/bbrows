<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.main.MainActivity"
    android:fitsSystemWindows="true"
    tools:deviceIds="tv"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/flWebViewContainer" />

    <!-- along the top edge of the window, above the bar (its elevation is higher), whether the bar is open or not -->
    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:id="@+id/progressBar"
        android:progressTint="?attr/tbColorProgress"
        android:progressBackgroundTint="@android:color/transparent"
        android:elevation="6dp"
        android:outlineProvider="none"
        android:visibility="visible" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rlActionBar"
        android:background="?attr/tbColorDsBgChrome"
        android:elevation="5dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.phlox.tvwebbrowser.activity.main.view.ActionBar
            android:id="@+id/vActionBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_size_chrome_control"
            android:layout_marginStart="@dimen/ds_space_screen_x"
            android:layout_marginEnd="@dimen/ds_space_screen_x"
            android:layout_marginTop="@dimen/ds_space_screen_top" />

        <!-- the bottom edge of the bar; the tabs are drawn over it -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_border_hairline"
            android:layout_alignBottom="@+id/vTabs"
            android:background="?attr/tbColorDsLine" />

        <com.phlox.tvwebbrowser.activity.main.view.tabs.TabsView
            android:id="@+id/vTabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_size_tab_height"
            android:layout_below="@+id/vActionBar"
            android:layout_marginTop="@dimen/ds_tab_strip_margin_top"
            android:paddingStart="@dimen/ds_space_screen_x"
            android:paddingEnd="@dimen/ds_space_screen_x"
            android:clipToPadding="false"
            android:focusable="true"
            />
    </RelativeLayout>

    <ImageView
        android:id="@+id/ivMiniatures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/llMiniaturePlaceholder"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignWithParentIfMissing="true"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_new_tab"
            app:tint="?attr/tbColorIconPlaceholder"
            android:layout_marginEnd="20dp"
            tools:ignore="ContentDescription" />
        <TextView
            style="@style/Widget.TVBro.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_a_new_tab_here" />
    </LinearLayout>

    
    <!-- under the focused tab: Down opens its menu -->
    <LinearLayout
        android:id="@+id/llTabOptionsHint"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ds_tab_hint_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/ds_tab_hint_padding_start"
        android:paddingEnd="@dimen/ds_tab_hint_padding_end"
        android:background="@drawable/ds_hint_bg"
        android:elevation="6dp"
        android:visibility="gone"
        android:importantForAccessibility="no">
        <ImageView
            android:layout_width="@dimen/ds_tab_hint_icon"
            android:layout_height="@dimen/ds_tab_hint_icon"
            android:src="@drawable/ic_chevron_down"
            app:tint="?attr/tbColorDsIcon"
            tools:ignore="ContentDescription" />
        <TextView
            style="@style/Widget.TVBro.Text.TabTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_tab_hint_icon_text"
            android:fontFamily="sans-serif"
            android:textColor="?attr/tbColorDsInk"
            android:text="@string/tab_options" />
    </LinearLayout>

    <!-- the hint about a found video that plays in the page: at the top end, where the Videos button of the bar is -->
    <com.phlox.tvwebbrowser.activity.main.view.PageVideoHintView
        android:id="@+id/vPageVideoHint"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ds_size_toast_height"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/ds_space_screen_top"
        android:layout_marginEnd="@dimen/ds_space_screen_x"
        android:elevation="6dp" />

    <!-- Find in page, over the top end of the page (the bar closes when it opens) -->
    <com.phlox.tvwebbrowser.activity.main.view.TvFindBarView
        android:id="@+id/vFindBar"
        android:layout_width="@dimen/tv_find_bar_width"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/ds_space_screen_top"
        android:layout_marginEnd="@dimen/ds_space_screen_x"
        android:elevation="6dp" />

    <!-- above the bar (their elevation is higher) -->
    <com.phlox.tvwebbrowser.activity.main.view.TabMenuView
        android:id="@+id/vTabMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <com.phlox.tvwebbrowser.activity.main.view.SitePanelView
        android:id="@+id/vSitePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <com.phlox.tvwebbrowser.activity.main.view.BookmarksPanelView
        android:id="@+id/vBookmarksPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <!-- all downloads, over the whole window and the bar; its menus and the downloads panel go above it -->
    <com.phlox.tvwebbrowser.activity.main.view.DownloadsScreenView
        android:id="@+id/vDownloadsScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <!-- the history, over the whole window and the bar; its menus go above it -->
    <com.phlox.tvwebbrowser.activity.main.view.HistoryScreenView
        android:id="@+id/vHistoryScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <!-- the settings, over the whole window and the bar -->
    <com.phlox.tvwebbrowser.activity.main.view.SettingsScreenView
        android:id="@+id/vSettingsScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <!-- sending to the TV from other devices, over the whole window and the bar -->
    <com.phlox.tvwebbrowser.activity.main.view.TvSendScreenView
        android:id="@+id/vSendScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <com.phlox.tvwebbrowser.activity.main.view.DownloadsPanelView
        android:id="@+id/vDownloadsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <!-- the videos of the page other apps can play, under the Videos button of the bar -->
    <com.phlox.tvwebbrowser.activity.main.view.VideosPanelView
        android:id="@+id/vVideosPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <!-- the suggestions of the history under the address while it is edited (TvShell places it) -->
    <com.phlox.tvwebbrowser.activity.main.view.AddressSuggestionsView
        android:id="@+id/vAddressSuggestions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ds_menu_bg"
        android:elevation="7dp"
        android:visibility="gone" />

    <!-- the built-in player, over the whole window and the bar, in the dark tokens -->
    <com.phlox.tvwebbrowser.activity.main.view.PlayerScreenView
        android:id="@+id/vPlayerScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7.5dp"
        android:outlineProvider="none"
        android:theme="@style/ThemeOverlay.TVBro.Video" />

    <!-- the menus of the bookmarks and downloads panels, above them -->
    <com.phlox.tvwebbrowser.activity.main.view.PopupMenuView
        android:id="@+id/vPopupMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp"
        android:outlineProvider="none" />

    <com.phlox.tvwebbrowser.activity.main.view.CursorMenuView
        android:id="@+id/vCursorMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        />

    <!-- the seek bar of the video mode, across the bottom of the fullscreen video, in the dark tokens -->
    <com.phlox.tvwebbrowser.activity.main.view.VideoOsdView
        android:id="@+id/vVideoOsd"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_osd_height"
        android:layout_alignParentBottom="true"
        android:elevation="16dp"
        android:outlineProvider="none"
        android:theme="@style/ThemeOverlay.TVBro.Video"
        android:visibility="gone" />

    <!-- the choice among the streams the fullscreen video may be, over it, then the built-in player -->
    <com.phlox.tvwebbrowser.activity.main.view.PlayerPanelView
        android:id="@+id/vVideoChoice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="17dp"
        android:outlineProvider="none"
        android:theme="@style/ThemeOverlay.TVBro.Video" />

    <ProgressBar
        android:id="@+id/progressBarGeneric"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        />

    <!-- Live RAM & AdBlock Mini-HUD (shown below action bar when menu overlay is visible) -->
    <TextView
        android:id="@+id/tvRamHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/ds_space_screen_x"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/ds_menu_bg"
        android:textColor="?attr/tbColorDsInk"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        tools:text="540 MB free · 12 ads blocked" />

    <!-- Night Eye Shield warm blue-light filter overlay (passes all touches and focus through) -->
    <View
        android:id="@+id/vNightEyeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26FF8800"
        android:elevation="25dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Startup Splash / Loading Screen: Warm Living-Room Cinema -->
    <FrameLayout
        android:id="@+id/flSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#12110F"
        android:elevation="30dp"
        android:clickable="true"
        android:focusable="false">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_launcher_foreground"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name_short"
                android:textColor="#EFE9DE"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/splash_subtitle"
                android:textColor="#AAA398"
                android:textSize="14sp" />

            <!-- Indeterminate warm amber cinema loading track -->
            <ProgressBar
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="160dp"
                android:layout_height="4dp"
                android:layout_marginTop="24dp"
                android:indeterminate="true"
                android:indeterminateTint="#F59E0B"
                android:progressBackgroundTint="#262421" />

            <!-- Signature TV remote keycap hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/splash_remote_tip"
                android:textColor="#8A847A"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
